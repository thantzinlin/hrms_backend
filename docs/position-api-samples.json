{
  "description": "Position feature - sample request/response JSON for HRMS APIs",
  "position": {
    "create_request": {
      "method": "POST",
      "url": "/api/positions",
      "body": {
        "positionName": "Software Engineer",
        "description": "Develops and maintains software applications",
        "isActive": true
      }
    },
    "create_response": {
      "returnCode": "200",
      "returnMessage": "Success",
      "data": {
        "positionId": 1,
        "positionName": "Software Engineer",
        "description": "Develops and maintains software applications",
        "isActive": true
      }
    },
    "get_all_response": {
      "returnCode": "200",
      "returnMessage": "Success",
      "data": [
        {
          "positionId": 1,
          "positionName": "Software Engineer",
          "description": "Develops and maintains software applications",
          "isActive": true
        },
        {
          "positionId": 2,
          "positionName": "HR Manager",
          "description": "Manages human resources operations",
          "isActive": true
        }
      ]
    },
    "get_by_id_response": {
      "returnCode": "200",
      "returnMessage": "Success",
      "data": {
        "positionId": 1,
        "positionName": "Software Engineer",
        "description": "Develops and maintains software applications",
        "isActive": true
      }
    },
    "update_request": {
      "method": "PUT",
      "url": "/api/positions/1",
      "body": {
        "positionName": "Senior Software Engineer",
        "description": "Leads development of software applications",
        "isActive": true
      }
    }
  },
